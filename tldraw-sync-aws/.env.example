# Copy to .env and fill in. Consumed by `yarn dev` (--env-file) and `yarn start`.

# HTTP/WebSocket listen port
PORT=3001
NODE_ENV=development

# Redis: room ownership locks + handover pub/sub.
# In EKS this points at the ElastiCache endpoint (cluster mode disabled).
# Use rediss:// if encryption in transit is enabled.
REDIS_URL=redis://localhost:6379

# S3 bucket holding room snapshots (rooms/) and user assets (uploads/). Required.
S3_BUCKET_NAME=tldraw-test-bucket
AWS_REGION=us-east-1

# Local emulator only — points the S3 client at MinIO.
# Leave unset in production, where the real endpoint + IRSA credentials are used.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Local dev only — static credentials for MinIO. In EKS, IRSA supplies
# credentials through the default provider chain and these are unset.
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
