{
  "name": "tldraw-sync-aws",
  "private": true,
  "version": "1.0.0",
  "description": "Tldraw AWS Marketplace Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node -r dotenv/config dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:router": "tsx watch --clear-screen=false --env-file=.env src/router/index.ts",
    "start:router": "node dist/router/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@tldraw/sync-core": "^5.2.5",
    "@tldraw/tlschema": "^5.2.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lodash.throttle": "^4.1.1",
    "open-graph-scraper": "^6.10.0",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "prettier": "^3.5.3",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
