# Copy to .env and fill in. Consumed by `yarn dev` (--env-file) and `yarn start`.

# HTTP/WebSocket listen port
PORT=3001
NODE_ENV=development

# Redis: room ownership locks + handover pub/sub.
# In GKE this points at the Memorystore instance IP.
REDIS_URL=redis://localhost:6379

# GCS bucket holding room snapshots (rooms/) and user assets (uploads/). Required.
GCS_BUCKET_NAME=your-tldraw-bucket-name

# Local emulator only — points the GCS client at fake-gcs-server.
# Leave unset in production, where the real bucket + ADC are used.
# GCS_API_ENDPOINT=http://localhost:4443

# Local dev only — path to a service account key.
# In GKE, Workload Identity supplies credentials and this is unset.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
